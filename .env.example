# Copy this file to .env only when setting up a new environment.
# Replace placeholders in .env with your actual credentials.
# Never commit real credentials.

# Gemini embeddings
GEMINI_API_KEY=replace_with_your_gemini_api_key
EMBEDDING_MODEL=gemini-embedding-2-preview
EMBEDDING_DIM=3072

# Qdrant Cloud
QDRANT_CLUSTER_ENDPOINT=https://your-cluster-endpoint
QDRANT_API_KEY=replace_with_your_qdrant_api_key
QDRANT_COLLECTION=enterprise_rag_hybrid_v1

# Groq
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_API_KEY=
